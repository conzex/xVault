# Database Configuration
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="xvault_db"
DB_USER="xvault_user"
DB_PASS="YOUR_SECURE_PASSWORD"

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL="vault@example.com"
SMTP_FROM_NAME="xVault Security"

# Application URL & Environment
APP_URL="auto"
APP_ENV="production"
